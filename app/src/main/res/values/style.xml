<?xml version="1.0" encoding="utf-8"?>
<resources>
   <!-- Base Application Theme -->
   <style name="Theme.KeyboardApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
       <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Surface and background -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>

        <!-- Keyboard-specific theme attributes -->
        <item name="keyboardBackground">?attr/colorSurface</item>
        <item name="keyboardKeyColor">@color/keyboard_key</item>
        <item name="keyboardKeyTextColor">@color/keyboard_key_text</item>

    </style>
   
   <!-- Key style (modular, reusable) -->
   <style name="KeyStyle">
      <item name="android:layout_width">0dp</item>
      <item name="android:layout_height">48dp</item>
      <item name="android:layout_weight">1</item>
      <item name="android:gravity">center</item>
      <item name="android:textSize">18sp</item>
      <item name="android:textColor">#FFFFFF</item>
    <!-- simple background 
      <item name="android:background">@drawable/key_bg</item>-->
      <item name="android:background">@android:color/holo_blue_dark</item> 
      <item name="android:layout_margin">2dp</item>
      <item name="android:clickable">true</item>
      <item name="android:focusable">true</item>
      <item name="android:textIsSelectable">false</item>
   </style>
</resources>
