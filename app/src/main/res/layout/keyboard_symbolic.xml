<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_symbols"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"
    android:padding="4dp">

    <!-- Row 1: Numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView style="@style/KeyStyle" android:text="1"/>
        <TextView style="@style/KeyStyle" android:text="2"/>
        <TextView style="@style/KeyStyle" android:text="3"/>
        <TextView style="@style/KeyStyle" android:text="4"/>
        <TextView style="@style/KeyStyle" android:text="5"/>
        <TextView style="@style/KeyStyle" android:text="6"/>
        <TextView style="@style/KeyStyle" android:text="7"/>
        <TextView style="@style/KeyStyle" android:text="8"/>
        <TextView style="@style/KeyStyle" android:text="9"/>
        <TextView style="@style/KeyStyle" android:text="0"/>
    </LinearLayout>

    <!-- Row 2: Primary symbols -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView style="@style/KeyStyle" android:text="@" />
        <TextView style="@style/KeyStyle" android:text="#" />
        <TextView style="@style/KeyStyle" android:text="$" />
        <TextView style="@style/KeyStyle" android:text="%" />
        <TextView style="@style/KeyStyle" android:text="&amp;" />
        <TextView style="@style/KeyStyle" android:text="-" />
        <TextView style="@style/KeyStyle" android:text="+" />
        <TextView style="@style/KeyStyle" android:text="(" />
        <TextView style="@style/KeyStyle" android:text=")" />
    </LinearLayout>

    <!-- Row 3: Secondary symbols -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView style="@style/KeyStyle" android:text="*" />
        <TextView style="@style/KeyStyle" android:text="\\"/>
        <TextView style="@style/KeyStyle" android:text="&apos;"/>
        <TextView style="@style/KeyStyle" android:text=":" />
        <TextView style="@style/KeyStyle" android:text=";" />
        <TextView style="@style/KeyStyle" android:text="!" />
        <TextView style="@style/KeyStyle" android:text="?" />
        <TextView style="@style/KeyStyle" android:text="/" />
    </LinearLayout>

    <!-- Row 4: Control row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="ABC"
            android:tag="LETTERS"/>

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="4"
            android:text="␣"
            android:tag="SPACE"/>

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="⌫"
            android:tag="BACKSPACE"/>
    </LinearLayout>

</LinearLayout>

