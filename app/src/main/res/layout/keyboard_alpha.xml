<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/keyboard_root"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:background="@color/keyboard_background"
   android:padding="4dp">

   <!-- Row 1 -->
   <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="3dp"
      android:background="#222222">

      <TextView style="@style/KeyStyle" android:text="Q" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="W" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="E" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="R" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="T" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="Y" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="U" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="I" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="O" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="P" android:tag="letterKey"/>
   </LinearLayout>

   <!-- Row 2 -->
   <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="3dp">

      <TextView style="@style/KeyStyle" android:text="A" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="S" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="D" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="F" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="G" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="H" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="J" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="K" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="L" android:tag="letterKey"/>
   </LinearLayout>

   <!-- Row 3 -->
   <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="3dp">

      <TextView style="@style/KeyStyle" android:text="⇧" android:tag="SHIFT" android:layout_weight="1.5" android:contentDescription="Shift key"/>
      <TextView style="@style/KeyStyle" android:text="Z" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="X" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="C" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="V" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="B" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="N" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="M" android:tag="letterKey"/>
      <TextView style="@style/KeyStyle" android:text="⌫" android:tag="BACKSPACE" android:layout_weight="1.5" android:contentDescription="Backspace"/>
   </LinearLayout>

   <!-- Row 4 -->
   <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="3dp">

      <TextView style="@style/KeyStyle" android:text="123" android:tag="SYMBOLS" android:layout_weight="1.5"/>
      <TextView style="@style/KeyStyle" android:text="␣" android:tag="SPACE" android:layout_weight="4"/>
      <TextView style="@style/KeyStyle" android:text="⏎" android:tag="ENTER" android:layout_weight="1.5" android:contentDescription="Enter"/>
   </LinearLayout>
</LinearLayout>



