{
  "id": "numpad",
  "type": "numpad",
  "name": "Numeric Keypad",
  "version": 1,
  "extends": null,

  "requires": {
    "layoutVersion": 1,
    "engineVersion": 1,
    "features": []
  },

  "metadata": {
    "language": "Universal",
    "locale": "und",
    "author": "Xavatar",
    "description": "Numeric keypad with operators",
    "license": "MIT",
    "created": "2026-08-02",
    "updated": "2026-08-02",
    "tags": [
      "numbers",
      "calculator",
      "numeric"
    ]
  },

  "defaults": {
    "type": "CHAR",
    "width": 1.0,
    "height": 56,
    "enabled": true,
    "visible": true,
    "uppercaseLabel": false
  },

  "rows": [
    {
      "keys": [
        { "id": "7" }, { "id": "8" }, { "id": "9" },
        { "id": "(" }, { "id": ")" }
      ]
    },

    {
      "keys": [
        { "id": "4" }, { "id": "5" }, { "id": "6" },
        { "id": "×" }, { "id": "÷" }
      ]
    },


    {
      "keys": [
        { "id": "1" }, { "id": "2" }, { "id": "3" },
        { "id": "+" }, { "id": "−" }
      ]
    },


    {
      "keys": [
        { "id": "." }, { "id": "0", "width": 1.0 },
        { "id": "=" }, { "id": "%" },
        { "id": "clear", "label": "C", "type": "ACTION" }
      ]
    },


    {
      "keys": [
        { "id": "abc", "label": "ABC", "type": "ACTION", "width": 1.5  },
        { "id": "math", "label": "=<", "type": "ACTION", "width": 1.5  },
        { "id": "space", "type": "SPACE", "width": 2.5 },
        { "id": "delete", "label": "⌫", "type": "DELETE", "width": 1.5 },
        { "id": "enter", "label": "⏎", "type": "ENTER", "width": 1.5 }
      ]
    }

  ]
}