{
  "id": "symbols",
  "type": "symbols",
  "name": "Symbols",
  "version": 1,
  "extends": "qwerty",

  "requires": {
    "layoutVersion": 1,
    "engineVersion": 1,
    "features": [
      "longPress",
      "popup"
    ]
  },

  "metadata": {
    "language": "Universal",
    "locale": "en-US",
    "author": "Xavatar",
    "description": "Primary symbols keyboard layout",
    "license": "MIT",
    "created": "2026-07-26",
    "updated": "2026-07-26",
    "tags": [
      "symbols",
      "punctuation"
    ]
  },

  "defaults": {
    "type": "CHAR",
    "width": 1.0,
    "height": 56,
    "enabled": true,
    "visible": true,
    "uppercaseLabel": false
  },

  "rows": [
    {
      "keys": [
        {"id":"1","label":"1"},
        {"id":"2","label":"2"},
        {"id":"3","label":"3"},
        {"id":"4","label":"4"},
        {"id":"5","label":"5"},
        {"id":"6","label":"6"},
        {"id":"7","label":"7"},
        {"id":"8","label":"8"},
        {"id":"9","label":"9"},
        {"id":"0","label":"0"}
      ]
    },

    {
      "keys": [
        {"id":"@","label":"@"},
        {"id":"#","label":"#"},
        {"id":"$","label":"$"},
        {"id":"%","label":"%"},
        {"id":"&","label":"&"},
        {"id":"-","label":"-"},
        {"id":"+","label":"+"},
        {"id":"(","label":"("},
        {"id":")","label":")"}
      ]
    },

    {
      "keys": [
        {
          "id":"symbols2",
          "label":"=<",
          "type":"ACTION",
          "width":1.4
        },

        {"id":"*","label":"*"},
        {"id":"\"","label":"\""},
        {"id":"'","label":"'"},
        {"id":":","label":":"},
        {"id":";","label":";"},
        {"id":"!","label":"!"},

        {
          "id":"delete",
          "label":"⌫",
          "type":"DELETE",
          "width":1.5
        }
      ]
    },

    {
      "keys":[
        {
          "id":"abc",
          "label":"ABC",
          "type":"ACTION",
          "width":1.4
        },

        {
          "id":"emoji",
          "label":"👻",
          "type":"EMOJI",
          "width":1.3
        },

        {
          "id":"space",
          "type":"SPACE",
          "width":5.5
        },

        {
          "id":"enter",
          "label":"⏎",
          "type":"ENTER",
          "width":1.6
        }
      ]
    }
  ]
}